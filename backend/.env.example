# Required: one or more comma-separated Google AI Studio keys.
GEMINI_API_KEYS=your-gemini-api-key

# Optional: defaults to gemini-2.5-flash-lite.
GEMINI_MODEL=gemini-2.5-flash-lite

# Required: Wolfram Cloud Secured Authentication Key.
WOLFRAM_CONSUMER_KEY=your-wolfram-consumer-key
WOLFRAM_CONSUMER_SECRET=your-wolfram-consumer-secret

# Optional: comma-separated deployed frontend origins.
CORS_ORIGINS=https://your-frontend.example.com

# Optional: per-IP POST request limit.
RATE_LIMIT_PER_MINUTE=30

# Optional, server-to-server only. Do not set for the current browser frontend.
# STEPWISE_API_KEY=your-server-to-server-key
